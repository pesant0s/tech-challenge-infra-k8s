# Copie para terraform.tfvars e ajuste. O arquivo real não é versionado.

# A conta vem de AWS_PROFILE (ou das credenciais no ambiente) — não fixe perfil aqui.
regiao     = "us-east-1"
# org_github vem do remote do git quando se usa `make`. Só defina se rodar
# o terraform diretamente:
# org_github = "seu-usuario-github"
# id_dono_github = "12345678"   # gh api users/seu-usuario-github --jq .id

# Chave de licença do New Relic (painel → API keys → INGEST-LICENSE).
# Deixe vazia para subir o cluster sem o agente.
newrelic_license_key = ""

# Dashboards, alertas e monitor de uptime (painel → API keys → USER key, e o ID da conta).
# Vazios, nada disso é criado.
newrelic_api_key    = ""
newrelic_account_id = ""
# newrelic_regiao   = "EU"
# email_alertas     = "voce@exemplo.com"
